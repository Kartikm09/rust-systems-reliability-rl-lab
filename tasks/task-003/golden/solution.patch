+# Candidate Notes
+
+Introduces exhaustive domain variants while preserving exact Display strings and stable CLI-style exit code contracts.
diff --git a/src/lib.rs b/src/lib.rs
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -1,9 +1,17 @@
 #![forbid(unsafe_code)]
 
-pub fn process(value: &str) -> Result<u64, String> {
-    if value.is_empty() { return Err("input is empty".to_owned()); }
-    value.parse::<u64>().map_err(|_| "input is not an integer".to_owned())
+#[derive(Debug, Eq, PartialEq)]
+pub enum DomainError { EmptyInput, InvalidInteger }
+impl std::fmt::Display for DomainError {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str(match self { Self::EmptyInput => "input is empty", Self::InvalidInteger => "input is not an integer" })
+    }
 }
-pub fn exit_code(message: &str) -> i32 {
-    if message == "input is empty" { 64 } else { 65 }
+impl std::error::Error for DomainError {}
+pub fn process(value: &str) -> Result<u64, DomainError> {
+    if value.is_empty() { return Err(DomainError::EmptyInput); }
+    value.parse::<u64>().map_err(|_| DomainError::InvalidInteger)
 }
+pub const fn exit_code(error: &DomainError) -> i32 {
+    match error { DomainError::EmptyInput => 64, DomainError::InvalidInteger => 65 }
+}
