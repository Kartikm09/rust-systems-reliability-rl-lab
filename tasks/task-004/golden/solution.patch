diff --git a/src/lib.rs b/src/lib.rs
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -2,12 +2,12 @@
 use std::collections::VecDeque;
 #[derive(Clone, Debug, Eq, PartialEq)]
 pub struct Job { pub id: u64, pub payload: String }
-pub struct Scheduler { queue: VecDeque<Job>, history: Vec<Job>, clone_work: usize }
+pub struct Scheduler { queue: VecDeque<Job>, history_ids: Vec<u64> }
 impl Scheduler {
-    pub fn new() -> Self { Self { queue: VecDeque::new(), history: Vec::new(), clone_work: 0 } }
-    pub fn submit(&mut self, job: &Job) { self.queue.push_back(job.clone()); self.history.push(job.clone()); self.clone_work += 2; }
-    pub fn take(&mut self) -> Option<Job> { let job = self.queue.front()?.clone(); self.queue.pop_front(); self.clone_work += 1; Some(job) }
-    pub fn clone_work(&self) -> usize { self.clone_work }
-    pub fn history_ids(&self) -> Vec<u64> { self.history.iter().map(|job| job.id).collect() }
+    pub fn new() -> Self { Self { queue: VecDeque::new(), history_ids: Vec::new() } }
+    pub fn submit(&mut self, job: Job) { self.history_ids.push(job.id); self.queue.push_back(job); }
+    pub fn take(&mut self) -> Option<Job> { self.queue.pop_front() }
+    pub const fn clone_work(&self) -> usize { 0 }
+    pub fn history_ids(&self) -> Vec<u64> { self.history_ids.clone() }
 }
 impl Default for Scheduler { fn default() -> Self { Self::new() } }
