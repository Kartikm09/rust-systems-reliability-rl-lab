 fn main() {
     let mut scheduler = Scheduler::new();
-    for id in 0..100 { scheduler.submit(&Job { id, payload: "x".repeat(128) }); }
+    for id in 0..100 { scheduler.submit(Job { id, payload: "x".repeat(128) }); }
